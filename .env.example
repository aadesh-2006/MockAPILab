# ==========================================
# MockAPILab - Environment Variables Template
# Copy this file to .env for local overrides
# DO NOT COMMIT SENSITIVE SECRETS TO GIT
# ==========================================

# Application Environment
ENVIRONMENT=development
SERVER_PORT=8080
CLIENT_PORT=5173

# PostgreSQL Database Configuration (Milestone 2)
POSTGRES_DB=mockapilab
POSTGRES_USER=mockapilab_user
POSTGRES_PASSWORD=mockapilab_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SPRING_DATASOURCE_USERNAME=${POSTGRES_USER}
SPRING_DATASOURCE_PASSWORD=${POSTGRES_PASSWORD}

# JWT Authentication Configuration (Milestone 2)
# Ensure JWT_SECRET is at least 256 bits (32 characters) for HMAC-SHA256
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Redis State Cache Configuration (Future Milestones)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Event Streaming Configuration (Future Milestones)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=mockapilab-group

# AI Assistant Integration (Gemini API) (Future Milestones)
# AI will be used for contract extraction and schema inference, not core runtime logic.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
