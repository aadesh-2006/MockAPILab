# ==========================================
# MockAPILab - Environment Variables Template
# Copy this file to .env for local overrides
# DO NOT COMMIT SENSITIVE SECRETS TO GIT
# ==========================================

# Application Environment
ENVIRONMENT=development
SERVER_PORT=8080
CLIENT_PORT=5173

# PostgreSQL Database Configuration (Future Milestones)
POSTGRES_DB=mockapilab
POSTGRES_USER=mockapilab_user
POSTGRES_PASSWORD=mockapilab_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis State Cache Configuration (Future Milestones)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Event Streaming Configuration (Future Milestones)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=mockapilab-group

# AI Assistant Integration (Gemini API) (Future Milestones)
# AI will be used for contract extraction and schema inference, not core runtime logic.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
